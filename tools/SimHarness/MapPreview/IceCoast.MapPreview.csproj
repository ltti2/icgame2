<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders a generated world to an isometric PPM image without Unity, using the same projection
       maths as IsoProjection. Handy for tuning the terrain generator. Args: seed, output path, scale. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IceCoast.Simulation.csproj" />
    <Compile Include="../../../Assets/_Project/Tests/EditMode/TestGames.cs" />
    <Compile Include="MapPreview.cs" />
  </ItemGroup>
</Project>
