<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the EditMode tests outside Unity (CI, quick iteration). The NUnit shim stands in for
       nunit.framework so this works offline; inside Unity the real NUnit is used. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IceCoast.Simulation.csproj" />
    <Compile Include="../../../Assets/_Project/Tests/EditMode/**/*.cs" />
    <Compile Include="NUnitShim.cs" />
    <Compile Include="TestRunner.cs" />
  </ItemGroup>
</Project>
